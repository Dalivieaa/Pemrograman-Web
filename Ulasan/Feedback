formulir.css
#--------------
body { margin:0; font-family:Arial; background:#e0f2fe; }
nav { background:white; padding:15px; }
nav img { height:40px; }
nav a { color:blue; margin:10px; text-decoration:none; }
.box { background:white; width:300px; margin:30px auto; padding:20px; border-radius:10px; }
input:not([type=radio]), textarea { width:100%; padding:8px; margin:5px 0; box-sizing:border-box; }
input[type=radio] { width:auto; }
button { width:100%; padding:10px; background:blue; color:white; border:0; }
#pesan { color:red; }

formulir.js
-----------------
document.getElementById("kirim").onclick = function() {
var nama = document.getElementById("nama").value;
var email = document.getElementById("email").value;
var ulasan = document.getElementById("ulasan").value;
var rating = document.querySelector('input[name="r"]:checked');
if (nama == "") alert("Nama harus diisi");
else if (email == "" || email.indexOf("@") == -1) alert("Email tidak valid");
else if (rating == null) alert("Pilih rating");
else if (ulasan == "") alert("Ulasan harus diisi");
else window.location.href = "tx.html";
};


